/dts-v1/;
#include <xilinx/zynq7000.dtsi>
#include "pynq_z1-pinctrl.dtsi"

/ {
	compatible = "digilent,zynq-pynq-z1", "xlnx,zynq-7000";
	model = "Digilent PYNQ-Z1";

	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		watchdog0 = &watchdog0;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ocm = &ocm_high;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a9";
			reg = <0>;
			device_type = "cpu";
		};

		cpu1: cpu@1 {
			compatible = "arm,cortex-a9";
			reg = <1>;
			device_type = "cpu";
		};
	};

	/*
	 * 512 MB DDR3. Reserve the low 1 MB so Zephyr does not overlap memory
	 * used by U-Boot or the ARM exception vector table relocated to 0x0.
	 */
	sram0: memory@100000 {
		compatible = "mmio-sram";
		reg = <0x00100000 DT_SIZE_M(511)>;
	};
};

/* The GTC is clocked at 1/2 of the CPU frequency (650 MHz / 2 = 325 MHz) */
&arch_timer {
	clock-frequency = <325000000>;
};

&uart0 {
	current-speed = <115200>;
	clock-frequency = <100000000>;
	pinctrl-0 = <&pinctrl_uart0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&devcfg {
	status = "okay";
};

&xadc {
	/* PS_CLK is a 50 MHz oscillator: ARM PLL 1300 MHz (CPU 650 MHz), IO PLL 1000 MHz */
	ps-clk-frequency = <50000000>;
	/*
	 * Arduino analog pins A0-A5 are VAUX1, VAUX9, VAUX6, VAUX15, VAUX5 and VAUX13. The board
	 * scales 0-3.3 V down to the 0-1 V XADC range; all of them are unipolar.
	 */
	xlnx,channels = <1 9 6 15 5 13>;
	status = "okay";
};

&watchdog0 {
	/* SWDT runs from CPU_1x = 650 MHz / 6 */
	clock-frequency = <108333333>;
	status = "okay";
};

&dmac_s {
	status = "okay";
};

&qspi {
	/* LQSPI reference clock: IO PLL 1000 MHz / 5, programmed by the boot firmware */
	clock-frequency = <200000000>;
	status = "okay";

	qspi_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		jedec-id = [ef 70 18]; /* Winbond W25Q128JV-IM */
		size = <DT_SIZE_M(128)>; /* bits: 16 MiB */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Untouched: whatever the board shipped or was provisioned with */
			qspi_data: partition@0 {
				label = "qspi-data";
				reg = <0x00000000 DT_SIZE_M(15)>;
				read-only;
			};

			/* The only region the tests may erase or program */
			qspi_scratch: partition@f00000 {
				label = "qspi-scratch";
				reg = <0x00f00000 DT_SIZE_M(1)>;
			};
		};
	};
};

&sdhci_ref_clk {
	/* SLCR SDIO_CLK_CTRL as left by the boot firmware: IO PLL 1000 MHz / 20 */
	clock-frequency = <DT_FREQ_M(50)>;
};

&sdhc0 {
	/*
	 * microSD slot on MIO40-45 (SDIO0). The MIO mux, card-detect routing and SDIO reference
	 * clock are programmed by the boot firmware (BootROM/FSBL/U-Boot boot from this slot).
	 */
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&psgpio {
	status = "okay";
};

&gem0 {
	phy-handle = <&gem0_phy>;
	clock-frequency = <1000000000>;
	local-mac-address = [9e 5c 1a 8a bf 53];
	status = "okay";
};

&gem0_mdio {
	status = "okay";

	gem0_phy: phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		status = "okay";
	};
};
