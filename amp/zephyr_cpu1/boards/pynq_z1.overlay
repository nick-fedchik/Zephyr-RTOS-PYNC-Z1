/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Relocate Zephyr into the 16 MiB remoteproc carveout (0x1e000000) and disable
 * peripherals owned by Linux on CPU0 (UART0, GEM0).
 */

/ {
	model = "Digilent PYNQ-Z1 (AMP CPU1 remoteproc)";

	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

&sram0 {
	reg = <0x1e000000 DT_SIZE_M(16)>;
};

/* PYNQ Linux configures Cortex-A9 GTC_CTRL prescaler=1 (/2): 325 MHz / 2 = 162.5 MHz */
&arch_timer {
	clock-frequency = <162500000>;
};

&uart0 {
	status = "disabled";
};

&watchdog0 {
	status = "disabled";
};

&qspi {
	status = "disabled";
};

&gem0 {
	status = "disabled";
};

&gem0_mdio {
	status = "disabled";
};
