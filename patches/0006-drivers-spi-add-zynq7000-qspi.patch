@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: Apache-2.0
+
+description: Xilinx Zynq-7000 PS Quad-SPI controller (I/O mode)
+
+compatible: "xlnx,zynq-qspi-1.0"
+
+include: [spi-controller.yaml]
+
+properties:
+  reg:
+    required: true
+
+  clock-frequency:
+    required: true
+    description: |
+      Frequency in Hz of the LQSPI reference clock (SLCR LQSPI_CLK_CTRL),
+      as left by the boot firmware. The SPI clock is this value divided by
+      2, 4 ... 256.
