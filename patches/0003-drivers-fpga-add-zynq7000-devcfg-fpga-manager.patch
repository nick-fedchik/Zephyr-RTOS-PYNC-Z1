diff --git a/dts/bindings/fpga/xlnx,zynq-devcfg-1.0.yaml b/dts/bindings/fpga/xlnx,zynq-devcfg-1.0.yaml
new file mode 100644
index 00000000000..59c103b8bb6
--- /dev/null
+++ b/dts/bindings/fpga/xlnx,zynq-devcfg-1.0.yaml
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Xilinx Zynq-7000 Device Configuration (DevCfg) interface used to program the
+  Programmable Logic (PL) through the PCAP with a DMA transfer.
+
+  The compatible string matches the Linux devicetree binding.
+
+compatible: "xlnx,zynq-devcfg-1.0"
+
+include: base.yaml
+
+properties:
+  reg:
+    required: true
+
+  interrupts:
+    required: true
+
+  syscon:
+    type: phandle
+    required: true
+    description: |
+      Phandle to the System Level Control Registers (SLCR) node, used for the
+      PL reset (FPGA_RST_CTRL), level shifter (LVL_SHFTR_EN) and PCAP clock
+      registers.
