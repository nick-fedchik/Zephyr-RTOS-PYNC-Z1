+# Xilinx Zynq-7000 DevCfg FPGA manager driver configuration options
+
+# SPDX-License-Identifier: Apache-2.0
+
+config ZYNQ7000_FPGA
+	bool "Xilinx Zynq-7000 DevCfg FPGA manager driver"
+	default y
+	depends on DT_HAS_XLNX_ZYNQ_DEVCFG_1_0_ENABLED
+	depends on SYSCON && CACHE_MANAGEMENT
+	help
+	  Enable the Xilinx Zynq-7000 Device Configuration (DevCfg) driver that
+	  loads raw, byte-swapped .bin bitstreams into the Programmable Logic
+	  through the PCAP DMA interface.
+
+if ZYNQ7000_FPGA
+
+config ZYNQ7000_FPGA_STAGING_ADDR
+	hex "Bitstream staging area address"
+	default 0x05000000
+	help
+	  Physical DDR address of a memory window that the SoC maps as cacheable
+	  normal memory so that a bootloader (e.g. U-Boot tftpboot) can preload a
+	  .bin bitstream there for fpga_load(). Must be 1 MiB aligned and outside
+	  the Zephyr image.
+
+config ZYNQ7000_FPGA_STAGING_SIZE
+	hex "Bitstream staging area size"
+	default 0x01000000
+	help
+	  Size in bytes of the bitstream staging window, a multiple of 1 MiB.
+
+endif # ZYNQ7000_FPGA
diff --git a/drivers/fpga/fpga_zynq7000.c b/drivers/fpga/fpga_zynq7000.c
new file mode 100644
index 00000000000..d7678c3a5d8
--- /dev/null
+++ b/drivers/fpga/fpga_zynq7000.c
@@ -0,0 +1,327 @@
+/*
+ * Xilinx Zynq-7000 Device Configuration (DevCfg) FPGA manager
+ *
+ * Programs the Programmable Logic (PL) with a raw, byte-swapped .bin
+ * bitstream through the PCAP DMA interface (UG585 chapter 6). The register
+ * sequence follows mainline Linux drivers/fpga/zynq-fpga.c.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define DT_DRV_COMPAT xlnx_zynq_devcfg_1_0
+
+#include <errno.h>
+
+#include <zephyr/cache.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/fpga.h>
+#include <zephyr/drivers/syscon.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/sys_io.h>
+#include <zephyr/sys/util.h>
+
+LOG_MODULE_REGISTER(fpga_zynq7000, CONFIG_FPGA_LOG_LEVEL);
+
+/* DevCfg registers */
+#define DEVCFG_CTRL          0x00
+#define DEVCFG_INT_STS       0x0c
+#define DEVCFG_INT_MASK      0x10
+#define DEVCFG_STATUS        0x14
+#define DEVCFG_DMA_SRC_ADDR  0x18
+#define DEVCFG_DMA_DST_ADDR  0x1c
+#define DEVCFG_DMA_SRC_LEN   0x20
+#define DEVCFG_DMA_DEST_LEN  0x24
+#define DEVCFG_UNLOCK        0x34
+#define DEVCFG_MCTRL         0x80
+
+#define DEVCFG_UNLOCK_KEY    0x757bdf0dU
+
+#define CTRL_PCFG_PROG_B     BIT(30)
+#define CTRL_PCAP_PR         BIT(27)
+#define CTRL_PCAP_MODE       BIT(26)
+
+#define STATUS_DMA_Q_F       BIT(31)
+#define STATUS_DMA_Q_E       BIT(30)
+#define STATUS_PCFG_INIT     BIT(4)
+
+#define INT_PCFG_DONE        BIT(2)
+#define INT_D_P_DONE         BIT(12)
+#define INT_ERROR_FLAGS      0x00f0c860U
+#define INT_ALL              0xf8f7f87fU
+
+#define MCTRL_PCAP_LPBK      BIT(4)
+
+#define DMA_SRC_LAST         BIT(0)
+#define DMA_INVALID_ADDR     0xffffffffU
+
+/* SLCR registers (offsets from the SLCR base) */
+#define SLCR_PCAP_CLK_CTRL   0x168
+#define SLCR_FPGA_RST_CTRL   0x240
+#define SLCR_LVL_SHFTR_EN    0x900
+
+#define PCAP_CLKACT          BIT(0)
+#define LVL_SHFTR_DISABLE    0x0
+#define LVL_SHFTR_PS_TO_PL   0xa
+#define LVL_SHFTR_ALL        0xf
+#define FPGA_RST_ALL         0xf
+#define FPGA_RST_NONE        0x0
+
+#define SYNC_WORD_SCAN_LEN   128
+#define INIT_POLL_TIMEOUT_MS 2500
+#define DONE_POLL_TIMEOUT_MS 2500
+#define DMA_TIMEOUT_MS       5000
+#define POLL_DELAY_US        20
+
+struct zynq_devcfg_config {
+	mm_reg_t base;
+	const struct device *slcr;
+};
+
+struct zynq_devcfg_data {
+	struct k_mutex lock;
+};
+
+static inline uint32_t devcfg_read(const struct device *dev, uint32_t off)
+{
+	const struct zynq_devcfg_config *cfg = dev->config;
+
+	return sys_read32(cfg->base + off);
+}
+
+static inline void devcfg_write(const struct device *dev, uint32_t off, uint32_t val)
+{
+	const struct zynq_devcfg_config *cfg = dev->config;
+
+	sys_write32(val, cfg->base + off);
+}
+
+static inline void slcr_write(const struct device *dev, uint32_t off, uint32_t val)
+{
+	const struct zynq_devcfg_config *cfg = dev->config;
+
+	(void)syscon_write_reg(cfg->slcr, off, val);
+}
+
+static int devcfg_poll(const struct device *dev, uint32_t off, uint32_t mask,
+		       uint32_t expected, uint32_t timeout_ms, uint32_t abort_mask)
+{
+	int64_t deadline = k_uptime_get() + timeout_ms;
+	uint32_t val;
+
+	do {
+		val = devcfg_read(dev, off);
+		if ((val & mask) == expected) {
+			return 0;
+		}
+		if (val & abort_mask) {
+			return -EIO;
+		}
+		k_busy_wait(POLL_DELAY_US);
+	} while (k_uptime_get() < deadline);
+
+	val = devcfg_read(dev, off);
+
+	return ((val & mask) == expected) ? 0 : -ETIMEDOUT;
+}
+
+static bool has_sync_word(const uint8_t *buf, uint32_t size)
+{
+	size = MIN(size, SYNC_WORD_SCAN_LEN);
+
+	for (; size >= 4; buf += 4, size -= 4) {
+		if (buf[0] == 0x66 && buf[1] == 0x55 && buf[2] == 0x99 && buf[3] == 0xaa) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+/* Assert the AXI resets, gate PS<->PL level shifters and pulse PCFG_PROG_B. */
+static int zynq_devcfg_pl_reset(const struct device *dev)
+{
+	uint32_t ctrl;
+	int err;
+
+	slcr_write(dev, SLCR_FPGA_RST_CTRL, FPGA_RST_ALL);
+	slcr_write(dev, SLCR_LVL_SHFTR_EN, LVL_SHFTR_DISABLE);
+	slcr_write(dev, SLCR_LVL_SHFTR_EN, LVL_SHFTR_PS_TO_PL);
+
+	/* PCFG_INIT follows PCFG_PROG_B, UG585 "PL reset" sequence. */
+	ctrl = devcfg_read(dev, DEVCFG_CTRL);
+	devcfg_write(dev, DEVCFG_CTRL, ctrl | CTRL_PCFG_PROG_B);
+	err = devcfg_poll(dev, DEVCFG_STATUS, STATUS_PCFG_INIT, STATUS_PCFG_INIT,
+			  INIT_POLL_TIMEOUT_MS, 0);
+	if (err) {
+		LOG_ERR("timeout waiting for PCFG_INIT");
+		return err;
+	}
+
+	ctrl = devcfg_read(dev, DEVCFG_CTRL);
+	devcfg_write(dev, DEVCFG_CTRL, ctrl & ~CTRL_PCFG_PROG_B);
+	err = devcfg_poll(dev, DEVCFG_STATUS, STATUS_PCFG_INIT, 0, INIT_POLL_TIMEOUT_MS, 0);
+	if (err) {
+		LOG_ERR("timeout waiting for !PCFG_INIT");
+		return err;
+	}
+
+	ctrl = devcfg_read(dev, DEVCFG_CTRL);
+	devcfg_write(dev, DEVCFG_CTRL, ctrl | CTRL_PCFG_PROG_B);
+	err = devcfg_poll(dev, DEVCFG_STATUS, STATUS_PCFG_INIT, STATUS_PCFG_INIT,
+			  INIT_POLL_TIMEOUT_MS, 0);
+	if (err) {
+		LOG_ERR("timeout waiting for PCFG_INIT");
+	}
+
+	return err;
+}
+
+static enum FPGA_status zynq_devcfg_get_status(const struct device *dev)
+{
+	if (devcfg_read(dev, DEVCFG_INT_STS) & INT_PCFG_DONE) {
+		return FPGA_STATUS_ACTIVE;
+	}
+
+	return FPGA_STATUS_INACTIVE;
+}
+
+static const char *zynq_devcfg_get_info(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+
+	return "Xilinx Zynq-7000 DevCfg (PCAP)";
+}
+
+static int zynq_devcfg_reset(const struct device *dev)
+{
+	struct zynq_devcfg_data *data = dev->data;
+	int err;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	err = zynq_devcfg_pl_reset(dev);
+	devcfg_write(dev, DEVCFG_INT_STS, INT_ALL);
+	k_mutex_unlock(&data->lock);
+
+	return err;
+}
+
+static int zynq_devcfg_load(const struct device *dev, uint32_t *image_ptr, uint32_t img_size)
+{
+	struct zynq_devcfg_data *data = dev->data;
+	uint32_t ctrl, status, int_sts;
+	int err;
+
+	if (image_ptr == NULL || img_size == 0U || (img_size % 4U) != 0U ||
+	    ((uintptr_t)image_ptr % 8U) != 0U) {
+		LOG_ERR("bitstream must be non-empty, 8-byte aligned and a multiple of 4 bytes");
+		return -EINVAL;
+	}
+
+	if (!has_sync_word((const uint8_t *)image_ptr, img_size)) {
+		LOG_ERR("no sync word found, a byte-swapped .bin bitstream is required");
+		return -EINVAL;
+	}
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+
+	err = zynq_devcfg_pl_reset(dev);
+	if (err) {
+		goto out;
+	}
+
+	/* Enable the PCAP interface, hand PL configuration over to the PCAP. */
+	ctrl = devcfg_read(dev, DEVCFG_CTRL);
+	devcfg_write(dev, DEVCFG_CTRL, ctrl | CTRL_PCAP_PR | CTRL_PCAP_MODE);
+
+	status = devcfg_read(dev, DEVCFG_STATUS);
+	if ((status & STATUS_DMA_Q_F) || !(status & STATUS_DMA_Q_E)) {
+		LOG_ERR("DMA command queue not empty (STATUS=0x%08x)", status);
+		err = -EBUSY;
+		goto out;
+	}
+
+	/* Disable the internal PCAP loopback. */
+	devcfg_write(dev, DEVCFG_MCTRL, devcfg_read(dev, DEVCFG_MCTRL) & ~MCTRL_PCAP_LPBK);
+
+	/* Polled operation: mask every interrupt, the status bits still latch. */
+	devcfg_write(dev, DEVCFG_INT_MASK, 0xffffffffU);
+	devcfg_write(dev, DEVCFG_INT_STS, INT_ALL);
+
+	sys_cache_data_flush_range(image_ptr, img_size);
+
+	devcfg_write(dev, DEVCFG_DMA_SRC_ADDR, (uint32_t)(uintptr_t)image_ptr | DMA_SRC_LAST);
+	devcfg_write(dev, DEVCFG_DMA_DST_ADDR, DMA_INVALID_ADDR);
+	devcfg_write(dev, DEVCFG_DMA_SRC_LEN, img_size / 4U);
+	devcfg_write(dev, DEVCFG_DMA_DEST_LEN, 0);
+
+	err = devcfg_poll(dev, DEVCFG_INT_STS, INT_D_P_DONE, INT_D_P_DONE, DMA_TIMEOUT_MS,
+			  INT_ERROR_FLAGS);
+	int_sts = devcfg_read(dev, DEVCFG_INT_STS);
+	if (err) {
+		LOG_ERR("DMA %s: INT_STS=0x%08x CTRL=0x%08x STATUS=0x%08x MCTRL=0x%08x",
+			(err == -EIO) ? "error" : "timeout", int_sts,
+			devcfg_read(dev, DEVCFG_CTRL), devcfg_read(dev, DEVCFG_STATUS),
+			devcfg_read(dev, DEVCFG_MCTRL));
+		goto release;
+	}
+
+	err = devcfg_poll(dev, DEVCFG_INT_STS, INT_PCFG_DONE, INT_PCFG_DONE, DONE_POLL_TIMEOUT_MS,
+			  INT_ERROR_FLAGS);
+	if (err) {
+		LOG_ERR("PL did not assert DONE (INT_STS=0x%08x)", devcfg_read(dev, DEVCFG_INT_STS));
+	}
+
+release:
+	/* Release PCAP control back to the ICAP. */
+	devcfg_write(dev, DEVCFG_CTRL, devcfg_read(dev, DEVCFG_CTRL) & ~CTRL_PCAP_PR);
+
+	if (err == 0) {
+		slcr_write(dev, SLCR_LVL_SHFTR_EN, LVL_SHFTR_ALL);
+		slcr_write(dev, SLCR_FPGA_RST_CTRL, FPGA_RST_NONE);
+	}
+out:
+	k_mutex_unlock(&data->lock);
+
+	return err;
+}
+
+static int zynq_devcfg_init(const struct device *dev)
+{
+	const struct zynq_devcfg_config *cfg = dev->config;
+	struct zynq_devcfg_data *data = dev->data;
+	uint32_t val;
+
+	if (!device_is_ready(cfg->slcr)) {
+		LOG_ERR("SLCR device not ready");
+		return -ENODEV;
+	}
+
+	k_mutex_init(&data->lock);
+
+	devcfg_write(dev, DEVCFG_UNLOCK, DEVCFG_UNLOCK_KEY);
+
+	/* Make sure the PCAP reference clock is running. */
+	if (syscon_read_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, &val) == 0) {
+		slcr_write(dev, SLCR_PCAP_CLK_CTRL, val | PCAP_CLKACT);
+	}
+
+	return 0;
+}
+
+static DEVICE_API(fpga, zynq_devcfg_api) = {
+	.get_status = zynq_devcfg_get_status,
+	.reset = zynq_devcfg_reset,
+	.load = zynq_devcfg_load,
+	.get_info = zynq_devcfg_get_info,
+};
+
+static struct zynq_devcfg_data zynq_devcfg_data_0;
+
+static const struct zynq_devcfg_config zynq_devcfg_config_0 = {
+	.base = DT_INST_REG_ADDR(0),
+	.slcr = DEVICE_DT_GET(DT_INST_PHANDLE(0, syscon)),
+};
+
+DEVICE_DT_INST_DEFINE(0, zynq_devcfg_init, NULL, &zynq_devcfg_data_0, &zynq_devcfg_config_0,
+		      POST_KERNEL, CONFIG_FPGA_INIT_PRIORITY, &zynq_devcfg_api);
