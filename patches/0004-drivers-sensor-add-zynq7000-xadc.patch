@@ -0,0 +1,36 @@
+/*
+ * Copyright (c) 2026 Zephyr-RTOS-PYNC-Z1 contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief Xilinx Zynq-7000 XADC (PS-XADC interface) sensor channels
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_SENSOR_ZYNQ7000_XADC_H_
+#define ZEPHYR_INCLUDE_DRIVERS_SENSOR_ZYNQ7000_XADC_H_
+
+#include <zephyr/drivers/sensor.h>
+
+/**
+ * Driver specific channels. Values are reported in volts. The on-die
+ * temperature is available as SENSOR_CHAN_DIE_TEMP (degrees Celsius).
+ */
+enum sensor_channel_zynq7000_xadc {
+	/** PL core supply (VCCINT, ~1.0 V) */
+	SENSOR_CHAN_XADC_VCCINT = SENSOR_CHAN_PRIV_START,
+	/** PL auxiliary supply (VCCAUX, ~1.8 V) */
+	SENSOR_CHAN_XADC_VCCAUX,
+	/** PL block RAM supply (VCCBRAM, ~1.0 V) */
+	SENSOR_CHAN_XADC_VCCBRAM,
+	/** PS core supply (VCCPINT, ~1.0 V) */
+	SENSOR_CHAN_XADC_VCCPINT,
+	/** PS auxiliary supply (VCCPAUX, ~1.8 V) */
+	SENSOR_CHAN_XADC_VCCPAUX,
+	/** PS DDR I/O supply (VCCO_DDR, ~1.5 V on PYNQ-Z1) */
+	SENSOR_CHAN_XADC_VCCO_DDR,
+};
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_SENSOR_ZYNQ7000_XADC_H_ */
