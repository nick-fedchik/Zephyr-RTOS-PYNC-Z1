+
+description: |
+  Xilinx Zynq-7000 XADC, accessed from the processing system through the
+  XADC interface (XADCIF) located in the device configuration block
+  (UG585 chapter 30). The compatible string matches the Linux devicetree
+  binding.
+
+compatible: "xlnx,zynq-xadc-1.00.a"
+
+include: [sensor-device.yaml, base.yaml]
+
+properties:
+  reg:
+    required: true
+
+  syscon:
+    type: phandle
+    required: true
+    description: |
+      Phandle to the System Level Control Registers (SLCR) node, used to make
+      sure that the PCAP clock that drives the XADC interface is enabled.
diff --git a/include/zephyr/drivers/sensor/zynq7000_xadc.h b/include/zephyr/drivers/sensor/zynq7000_xadc.h
