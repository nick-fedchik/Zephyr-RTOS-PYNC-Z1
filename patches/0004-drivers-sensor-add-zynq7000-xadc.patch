+# Xilinx Zynq-7000 XADC sensor configuration options
+
+# Copyright (c) 2026 Zephyr-RTOS-PYNC-Z1 contributors
+# SPDX-License-Identifier: Apache-2.0
+
+config ZYNQ7000_XADC
+	bool "Xilinx Zynq-7000 XADC (die temperature and supply voltages)"
+	default y
+	depends on DT_HAS_XLNX_ZYNQ_XADC_1_00_A_ENABLED
+	depends on SYSCON
+	help
+	  Enable the polled driver for the Zynq-7000 PS-XADC interface. It
+	  reports the on-die temperature and the internal supply monitors.
diff --git a/drivers/sensor/xlnx/zynq7000_xadc.c b/drivers/sensor/xlnx/zynq7000_xadc.c
new file mode 100644
index 00000000000..cc52ae7988c
--- /dev/null
+++ b/drivers/sensor/xlnx/zynq7000_xadc.c
@@ -0,0 +1,276 @@
+/*
+ * Xilinx Zynq-7000 XADC sensor driver (PS-XADC interface)
+ *
+ * Reads the on-die temperature and the internal supply monitors through the
+ * XADCIF command/data FIFOs located in the DevCfg block (UG585 chapter 30,
+ * UG480). The register sequence follows mainline Linux
+ * drivers/iio/adc/xilinx-xadc-core.c. Transfers are polled.
+ *
+ * Copyright (c) 2026 Zephyr-RTOS-PYNC-Z1 contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define DT_DRV_COMPAT xlnx_zynq_xadc_1_00_a
+
+#include <errno.h>
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/sensor.h>
+#include <zephyr/drivers/sensor/zynq7000_xadc.h>
+#include <zephyr/drivers/syscon.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+
+LOG_MODULE_REGISTER(zynq7000_xadc, CONFIG_SENSOR_LOG_LEVEL);
+
+/* XADCIF registers (offsets from 0xF8007100) */
+#define XADCIF_CFG     0x00
+#define XADCIF_INTSTS  0x04
+#define XADCIF_INTMSK  0x08
+#define XADCIF_MSTS    0x0c
+#define XADCIF_CMDFIFO 0x10
+#define XADCIF_RDFIFO  0x14
+#define XADCIF_MCTL    0x18
+
+#define CFG_ENABLE        BIT(31)
+#define CFG_WEDGE         BIT(13)
+#define CFG_REDGE         BIT(12)
+#define CFG_TCKRATE_DIV16 (0x3U << 8)
+#define CFG_IGAP(x)       ((x) & 0x1f)
+#define CFG_IGAP_DEFAULT  20
+
+#define MSTS_DFIFO_LVL_SHIFT 12
+#define MSTS_DFIFO_LVL_MASK  (0xfU << MSTS_DFIFO_LVL_SHIFT)
+#define MSTS_DFIFOE          BIT(8)
+
+#define MCTL_RESET BIT(4)
+
+#define CMD_NOP   0x00U
+#define CMD_READ  0x01U
+#define CMD_WRITE 0x02U
+#define XADC_CMD(cmd, addr, data) (((cmd) << 26) | ((addr) << 16) | (data))
+
+/* XADC status registers (DRP addresses) */
+#define XADC_REG_TEMP     0x00
+#define XADC_REG_VCCINT   0x01
+#define XADC_REG_VCCAUX   0x02
+#define XADC_REG_VCCBRAM  0x06
+#define XADC_REG_VCCPINT  0x0d
+#define XADC_REG_VCCPAUX  0x0e
+#define XADC_REG_VCCO_DDR 0x0f
+
+/* 12-bit result left-aligned in the 16-bit register */
+#define XADC_RAW_SHIFT       4
+#define XADC_RESOLUTION_BITS 12
+/* Transfer function from UG480: T[C] = raw * 503.975 / 4096 - 273.15 */
+#define XADC_TEMP_SCALE_MC   503975LL
+#define XADC_TEMP_OFFSET_MC  273150LL
+/* Supply monitors: V = raw * 3.0 / 4096 */
+#define XADC_SUPPLY_FS_UV    3000000LL
+
+#define SLCR_PCAP_CLK_CTRL 0x168
+#define PCAP_CLKACT        BIT(0)
+
+#define XADC_TIMEOUT_US 5000
+#define XADC_POLL_US    5
+
+enum xadc_sample_idx {
+	IDX_TEMP,
+	IDX_VCCINT,
+	IDX_VCCAUX,
+	IDX_VCCBRAM,
+	IDX_VCCPINT,
+	IDX_VCCPAUX,
+	IDX_VCCO_DDR,
+	IDX_COUNT,
+};
+
+static const uint8_t xadc_regs[IDX_COUNT] = {
+	[IDX_TEMP] = XADC_REG_TEMP,
+	[IDX_VCCINT] = XADC_REG_VCCINT,
+	[IDX_VCCAUX] = XADC_REG_VCCAUX,
+	[IDX_VCCBRAM] = XADC_REG_VCCBRAM,
+	[IDX_VCCPINT] = XADC_REG_VCCPINT,
+	[IDX_VCCPAUX] = XADC_REG_VCCPAUX,
+	[IDX_VCCO_DDR] = XADC_REG_VCCO_DDR,
+};
+
+struct zynq_xadc_config {
+	mm_reg_t base;
+	const struct device *slcr;
+};
+
+struct zynq_xadc_data {
+	struct k_mutex lock;
+	uint16_t raw[IDX_COUNT];
+};
+
+static inline uint32_t xadc_read32(const struct device *dev, uint32_t off)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+
+	return sys_read32(cfg->base + off);
+}
+
+static inline void xadc_write32(const struct device *dev, uint32_t off, uint32_t val)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+
+	sys_write32(val, cfg->base + off);
+}
+
+static void xadc_drain_fifo(const struct device *dev)
+{
+	while (!(xadc_read32(dev, XADCIF_MSTS) & MSTS_DFIFOE)) {
+		(void)xadc_read32(dev, XADCIF_RDFIFO);
+	}
+}
+
+/* Read one XADC register; the caller holds the lock. */
+static int xadc_read_reg(const struct device *dev, uint8_t reg, uint16_t *val)
+{
+	uint32_t waited = 0;
+
+	xadc_drain_fifo(dev);
+
+	xadc_write32(dev, XADCIF_CMDFIFO, XADC_CMD(CMD_READ, reg, 0));
+	xadc_write32(dev, XADCIF_CMDFIFO, XADC_CMD(CMD_NOP, 0, 0));
+
+	/* The first response belongs to the READ command slot, the second one has the data */
+	while (((xadc_read32(dev, XADCIF_MSTS) & MSTS_DFIFO_LVL_MASK) >> MSTS_DFIFO_LVL_SHIFT) <
+	       2U) {
+		if (waited >= XADC_TIMEOUT_US) {
+			return -ETIMEDOUT;
+		}
+		k_busy_wait(XADC_POLL_US);
+		waited += XADC_POLL_US;
+	}
+
+	(void)xadc_read32(dev, XADCIF_RDFIFO);
+	*val = xadc_read32(dev, XADCIF_RDFIFO) & 0xffffU;
+
+	return 0;
+}
+
+static int zynq_xadc_sample_fetch(const struct device *dev, enum sensor_channel chan)
+{
+	struct zynq_xadc_data *data = dev->data;
+	uint16_t raw[IDX_COUNT];
+	int err = 0;
+
+	if (chan != SENSOR_CHAN_ALL && chan != SENSOR_CHAN_DIE_TEMP &&
+	    !((int)chan >= SENSOR_CHAN_XADC_VCCINT && (int)chan <= SENSOR_CHAN_XADC_VCCO_DDR)) {
+		return -ENOTSUP;
+	}
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	for (int i = 0; i < IDX_COUNT; i++) {
+		err = xadc_read_reg(dev, xadc_regs[i], &raw[i]);
+		if (err) {
+			LOG_ERR("XADC register 0x%02x read timed out", xadc_regs[i]);
+			break;
+		}
+	}
+	if (err == 0) {
+		memcpy(data->raw, raw, sizeof(raw));
+	}
+	k_mutex_unlock(&data->lock);
+
+	return err;
+}
+
+static int zynq_xadc_channel_get(const struct device *dev, enum sensor_channel chan,
+				 struct sensor_value *val)
+{
+	struct zynq_xadc_data *data = dev->data;
+	int64_t raw;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	switch ((int)chan) {
+	case SENSOR_CHAN_DIE_TEMP:
+		raw = data->raw[IDX_TEMP] >> XADC_RAW_SHIFT;
+		k_mutex_unlock(&data->lock);
+		/* degrees Celsius, computed in micro-degrees */
+		return sensor_value_from_micro(
+			val, ((raw * XADC_TEMP_SCALE_MC * 1000LL) >> XADC_RESOLUTION_BITS) -
+				     XADC_TEMP_OFFSET_MC * 1000LL);
+	case SENSOR_CHAN_XADC_VCCINT:
+		raw = data->raw[IDX_VCCINT];
+		break;
+	case SENSOR_CHAN_XADC_VCCAUX:
+		raw = data->raw[IDX_VCCAUX];
+		break;
+	case SENSOR_CHAN_XADC_VCCBRAM:
+		raw = data->raw[IDX_VCCBRAM];
+		break;
+	case SENSOR_CHAN_XADC_VCCPINT:
+		raw = data->raw[IDX_VCCPINT];
+		break;
+	case SENSOR_CHAN_XADC_VCCPAUX:
+		raw = data->raw[IDX_VCCPAUX];
+		break;
+	case SENSOR_CHAN_XADC_VCCO_DDR:
+		raw = data->raw[IDX_VCCO_DDR];
+		break;
+	default:
+		k_mutex_unlock(&data->lock);
+		return -ENOTSUP;
+	}
+	k_mutex_unlock(&data->lock);
+
+	raw >>= XADC_RAW_SHIFT;
+
+	/* volts */
+	return sensor_value_from_micro(val, (raw * XADC_SUPPLY_FS_UV) >> XADC_RESOLUTION_BITS);
+}
+
+static int zynq_xadc_init(const struct device *dev)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+	struct zynq_xadc_data *data = dev->data;
+	uint32_t val;
+
+	if (!device_is_ready(cfg->slcr)) {
+		LOG_ERR("SLCR device not ready");
+		return -ENODEV;
+	}
+
+	k_mutex_init(&data->lock);
+
+	/* The XADC interface is clocked by the PCAP clock. */
+	if (syscon_read_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, &val) == 0 && !(val & PCAP_CLKACT)) {
+		(void)syscon_write_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, val | PCAP_CLKACT);
+	}
+
+	xadc_write32(dev, XADCIF_MCTL, MCTL_RESET);
+	xadc_write32(dev, XADCIF_MCTL, 0);
+	xadc_write32(dev, XADCIF_INTSTS, UINT32_MAX);
+	/* All interrupts masked, results are polled */
+	xadc_write32(dev, XADCIF_INTMSK, UINT32_MAX);
+	/*
+	 * Slowest TCK divider (PCAP clock / 16, at most 12.5 MHz), well below the 50 MHz
+	 * limit and independent of the PCAP clock configuration chosen by U-Boot/Linux.
+	 */
+	xadc_write32(dev, XADCIF_CFG,
+		     CFG_ENABLE | CFG_REDGE | CFG_WEDGE | CFG_TCKRATE_DIV16 |
+			     CFG_IGAP(CFG_IGAP_DEFAULT));
+
+	return 0;
+}
+
+static DEVICE_API(sensor, zynq_xadc_api) = {
+	.sample_fetch = zynq_xadc_sample_fetch,
+	.channel_get = zynq_xadc_channel_get,
+};
+
+static struct zynq_xadc_data zynq_xadc_data_0;
+
+static const struct zynq_xadc_config zynq_xadc_config_0 = {
+	.base = DT_INST_REG_ADDR(0),
+	.slcr = DEVICE_DT_GET(DT_INST_PHANDLE(0, syscon)),
+};
+
+SENSOR_DEVICE_DT_INST_DEFINE(0, zynq_xadc_init, NULL, &zynq_xadc_data_0, &zynq_xadc_config_0,
+			     POST_KERNEL, CONFIG_SENSOR_INIT_PRIORITY, &zynq_xadc_api);
