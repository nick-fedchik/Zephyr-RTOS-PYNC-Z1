+static int xadc_update_reg(const struct device *dev, uint8_t reg, uint16_t mask, uint16_t val)
+{
+	uint16_t tmp;
+	int err;
+
+	err = xadc_read_reg(dev, reg, &tmp);
+	if (err) {
+		return err;
+	}
+
+	return xadc_write_reg(dev, reg, (tmp & ~mask) | val);
+}
