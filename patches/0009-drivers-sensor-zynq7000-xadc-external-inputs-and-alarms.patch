+/* Caller holds alarm_lock */
+static void xadc_update_intmsk(const struct device *dev)
+{
+	struct zynq_xadc_data *data = dev->data;
+	uint32_t unmasked = data->alarm_en & ~data->alarm_masked;
+
+	/* Only the alarm interrupts are ever used, everything else stays masked */
+	xadc_write32(dev, XADCIF_INTMSK, ~unmasked);
+}
+
+static void zynq_xadc_isr(const struct device *dev)
+{
+	struct zynq_xadc_data *data = dev->data;
+	k_spinlock_key_t key;
+	uint32_t status;
+
+	key = k_spin_lock(&data->alarm_lock);
+
+	status = xadc_read32(dev, XADCIF_INTSTS) & ~xadc_read32(dev, XADCIF_INTMSK);
+	status &= INT_ALARM_MASK;
+
+	/* The alarms are level sensitive: mask the active ones until the condition is gone */
+	data->alarm_masked |= status;
+	xadc_update_intmsk(dev);
+	xadc_write32(dev, XADCIF_INTSTS, status);
+
+	k_spin_unlock(&data->alarm_lock, key);
+
+	if (status) {
+		atomic_or(&data->alarm_pending, xadc_alarm_from_hw(status));
+		k_work_submit(&data->alarm_work);
+		k_work_reschedule(&data->unmask_work, K_MSEC(XADC_UNMASK_PERIOD_MS));
+	}
+}
+
+static void xadc_alarm_work_handler(struct k_work *work)
+{
+	struct zynq_xadc_data *data = CONTAINER_OF(work, struct zynq_xadc_data, alarm_work);
+	uint32_t pending = (uint32_t)atomic_clear(&data->alarm_pending);
+
+	for (int i = 0; i < ALARM_COUNT; i++) {
+		if ((pending & BIT(i)) && data->handler[i] != NULL) {
+			data->handler[i](data->dev, &data->trigger[i]);
+		}
+	}
+}
+
+static void xadc_unmask_work_handler(struct k_work *work)
+{
+	struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+	struct zynq_xadc_data *data = CONTAINER_OF(dwork, struct zynq_xadc_data, unmask_work);
+	const struct device *dev = data->dev;
+	k_spinlock_key_t key;
+	uint32_t active = xadc_read32(dev, XADCIF_MSTS) & MSTS_ALARM_MASK;
+	uint32_t unmask;
+	bool again;
+
+	key = k_spin_lock(&data->alarm_lock);
+
+	unmask = data->alarm_masked & ~active;
+	data->alarm_masked &= active & data->alarm_en;
+	/* Clear stale events before the interrupt is unmasked again */
+	xadc_write32(dev, XADCIF_INTSTS, unmask);
+	xadc_update_intmsk(dev);
+	again = data->alarm_masked != 0U;
+
+	k_spin_unlock(&data->alarm_lock, key);
+
+	if (again) {
+		k_work_reschedule(&data->unmask_work, K_MSEC(XADC_UNMASK_PERIOD_MS));
+	}
+}
