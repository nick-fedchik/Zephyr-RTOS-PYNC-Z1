+/* The XADCIF alarm bits are the 7-series ones with OT moved to bit 7 */
+static uint32_t xadc_alarm_to_hw(uint32_t alarm)
+{
+	return ((alarm & 0x08U) << 4) | ((alarm & 0xf0U) >> 1) | (alarm & 0x07U);
+}
+
+static uint32_t xadc_alarm_from_hw(uint32_t hw)
+{
+	return ((hw & 0x80U) >> 4) | ((hw & 0x78U) << 1) | (hw & 0x07U);
+}
