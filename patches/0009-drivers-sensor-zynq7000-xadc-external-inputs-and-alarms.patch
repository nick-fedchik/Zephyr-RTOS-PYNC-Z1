+static int xadc_wait_dfifo(const struct device *dev, uint32_t words)
+{
+	uint32_t waited = 0;
+
+	while (((xadc_read32(dev, XADCIF_MSTS) & MSTS_DFIFO_LVL_MASK) >> MSTS_DFIFO_LVL_SHIFT) <
+	       words) {
+		if (waited >= XADC_TIMEOUT_US) {
+			return -ETIMEDOUT;
+		}
+		k_busy_wait(XADC_POLL_US);
+		waited += XADC_POLL_US;
+	}
+
+	return 0;
+}
