+/* Enable or disable one alarm in CONF1 (disable bits) and in the interrupt mask */
+static int xadc_alarm_enable(const struct device *dev, uint8_t alarm, bool enable)
+{
+	struct zynq_xadc_data *data = dev->data;
+	uint32_t hw = xadc_alarm_to_hw(BIT(alarm));
+	k_spinlock_key_t key;
+	uint16_t dis;
+	int err;
+
+	if (alarm == ALARM_OT) {
+		dis = BIT(0);
+	} else if (alarm < ALARM_OT) {
+		dis = BIT(alarm + 1U);
+	} else {
+		dis = BIT(alarm + 4U);
+	}
+
+	/* Keep the interrupt masked while the alarm is switched, so no stale status is reported */
+	key = k_spin_lock(&data->alarm_lock);
+	if (enable) {
+		data->alarm_masked |= hw;
+	} else {
+		data->alarm_en &= ~hw;
+		data->alarm_masked &= ~hw;
+	}
+	xadc_update_intmsk(dev);
+	k_spin_unlock(&data->alarm_lock, key);
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	err = xadc_update_reg(dev, XADC_REG_CONF1, dis, enable ? 0U : dis);
+	k_mutex_unlock(&data->lock);
+	if (err) {
+		return err;
+	}
+
+	if (enable) {
+		/* Let the sequencer refresh the alarm status with the new thresholds */
+		k_msleep(XADC_ARM_SETTLE_MS);
+
+		key = k_spin_lock(&data->alarm_lock);
+		/* Drop events that were latched while the alarm was disabled */
+		xadc_write32(dev, XADCIF_INTSTS, hw);
+		data->alarm_en |= hw;
+		data->alarm_masked &= ~hw;
+		xadc_update_intmsk(dev);
+		k_spin_unlock(&data->alarm_lock, key);
+	}
+
+	return 0;
+}
+
+static int zynq_xadc_trigger_set(const struct device *dev, const struct sensor_trigger *trig,
+				 sensor_trigger_handler_t handler)
+{
+	struct zynq_xadc_data *data = dev->data;
+	k_spinlock_key_t key;
+	uint8_t reg, alarm;
+	bool is_temp, armed;
+	int err;
+
+	if (trig == NULL || trig->type != SENSOR_TRIG_THRESHOLD) {
+		return -ENOTSUP;
+	}
+
+	err = xadc_thresh_lookup(trig->chan, SENSOR_ATTR_UPPER_THRESH, &reg, &alarm, &is_temp);
+	if (err) {
+		return err;
+	}
+
+	if (handler == NULL) {
+		err = xadc_alarm_enable(dev, alarm, false);
+		data->handler[alarm] = NULL;
+		return err;
+	}
+
+	key = k_spin_lock(&data->alarm_lock);
+	armed = (data->alarm_en & xadc_alarm_to_hw(BIT(alarm))) != 0U;
+	k_spin_unlock(&data->alarm_lock, key);
+
+	data->trigger[alarm] = *trig;
+	data->handler[alarm] = handler;
+
+	/* Already armed: only the handler changes, an active alarm must not be reported again */
+	if (armed) {
+		return 0;
+	}
+
+	return xadc_alarm_enable(dev, alarm, true);
+}
+
+/* PCAP clock rate from the SLCR PLL and divider settings, 0 if it cannot be determined */
+static uint32_t xadc_pcap_rate(const struct device *dev)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+	uint32_t ctrl, pll, pll_reg;
+	uint64_t rate;
+
+	if (syscon_read_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, &ctrl) != 0 ||
+	    PCAP_DIVISOR(ctrl) == 0U) {
+		return 0U;
+	}
+
+	switch (PCAP_SRCSEL(ctrl)) {
+	case 2:
+		pll_reg = SLCR_ARM_PLL_CTRL;
+		break;
+	case 3:
+		pll_reg = SLCR_DDR_PLL_CTRL;
+		break;
+	default:
+		pll_reg = SLCR_IO_PLL_CTRL;
+		break;
+	}
+
+	if (syscon_read_reg(cfg->slcr, pll_reg, &pll) != 0) {
+		return 0U;
+	}
+
+	rate = cfg->ps_clk_hz;
+	if (!(pll & PLL_BYPASS_FORCE)) {
+		rate *= PLL_FDIV(pll);
+	}
+
+	return rate / PCAP_DIVISOR(ctrl);
+}
+
+/* Fastest TCK rate (CFG.TCKRATE) not above 50 MHz, the same rule as Linux. Returns the divider. */
+static uint32_t xadc_tck_divider(uint32_t pcap_rate, uint32_t *tckrate)
+{
+	uint32_t div;
+
+	if (pcap_rate == 0U) {
+		*tckrate = CFG_TCKRATE_DIV16;
+		return 16U;
+	}
+
+	if (XADC_TCK_MAX_HZ > pcap_rate / 2U) {
+		div = 2U;
+	} else {
+		div = pcap_rate / XADC_TCK_MAX_HZ;
+		if (pcap_rate / div > XADC_TCK_MAX_HZ) {
+			div++;
+		}
+	}
+
+	if (div <= 3U) {
+		*tckrate = CFG_TCKRATE_DIV2;
+		return 2U;
+	} else if (div <= 7U) {
+		*tckrate = CFG_TCKRATE_DIV4;
+		return 4U;
+	} else if (div <= 15U) {
+		*tckrate = CFG_TCKRATE_DIV8;
+		return 8U;
+	}
+
+	*tckrate = CFG_TCKRATE_DIV16;
+	return 16U;
+}
+
+/* Keep the conversion rate at or below 150 kSPS (26 ADCCLK cycles per conversion), as Linux */
+static int xadc_set_samplerate(const struct device *dev, uint32_t dclk)
+{
+	uint32_t val = XADC_MAX_SAMPLERATE * XADC_ADC_CYCLES;
+	uint32_t div;
+
+	if (dclk == 0U) {
+		return 0;
+	}
+
+	val = MAX(val, 1000000U);
+	div = MAX(dclk / val, 1U);
+	if (dclk / div / XADC_ADC_CYCLES > XADC_MAX_SAMPLERATE) {
+		div++;
+	}
+	div = CLAMP(div, 2U, 0xffU);
+
+	return xadc_update_reg(dev, XADC_REG_CONF2, CONF2_DIV_MASK, div << CONF2_DIV_SHIFT);
+}
+
+/* Program the sequencer for the internal channels plus the configured external inputs */
+static int xadc_setup_sequencer(const struct device *dev)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+	uint16_t aux = cfg->chan_mask & 0xffffU;
+	bool simultaneous = (aux & 0xff00U) && (aux & 0x00ffU);
+	uint16_t seq0 = SEQ0_CALIBRATION | SEQ0_VCCPINT | SEQ0_VCCPAUX | SEQ0_VCCO_DDR |
+			SEQ0_TEMP | SEQ0_VCCINT | SEQ0_VCCAUX | SEQ0_VCCBRAM;
+	uint16_t seq1 = aux;
+	uint16_t inmode0 = 0;
+	int err;
+
+	if (cfg->chan_mask & BIT(XADC_VPVN_CHAN)) {
+		seq0 |= SEQ0_VPVN;
+	}
+	if (cfg->bipolar_mask & BIT(XADC_VPVN_CHAN)) {
+		inmode0 |= SEQ0_VPVN;
+	}
+	/*
+	 * In simultaneous mode both ADCs convert VAUXn and VAUXn+8 together; the sequencer bit of
+	 * the lower channel covers the pair and the upper byte is ignored.
+	 */
+	if (simultaneous) {
+		seq1 = (aux | (aux >> 8)) & 0x00ffU;
+	}
+
+	err = xadc_update_reg(dev, XADC_REG_CONF1, CONF1_SEQ_MASK, CONF1_SEQ_DEFAULT);
+	if (err == 0) {
+		err = xadc_write_reg(dev, XADC_REG_INMODE(0), inmode0);
+	}
+	if (err == 0) {
+		err = xadc_write_reg(dev, XADC_REG_INMODE(1), cfg->bipolar_mask & 0xffffU);
+	}
+	if (err == 0) {
+		err = xadc_write_reg(dev, XADC_REG_SEQ(0), seq0);
+	}
+	if (err == 0) {
+		err = xadc_write_reg(dev, XADC_REG_SEQ(1), seq1);
+	}
+	if (err == 0) {
+		/* ADC B is only needed when it converts the upper aux channels simultaneously */
+		err = xadc_update_reg(dev, XADC_REG_CONF2, CONF2_PD_MASK,
+				      simultaneous ? 0U : CONF2_PD_ADC_B);
+	}
+	if (err == 0) {
+		err = xadc_update_reg(dev, XADC_REG_CONF1, CONF1_SEQ_MASK,
+				      simultaneous ? CONF1_SEQ_SIMULTANEOUS
+						   : CONF1_SEQ_CONTINUOUS);
+	}
+
+	return err;
+}
+
+/* Program the XADC interface, sample rate and sequencer; all alarms end up disabled. */
+static int xadc_hw_setup(const struct device *dev)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+	uint32_t val, pcap_rate, tckrate, tck_div;
+	int err;
 
 	/* The XADC interface is clocked by the PCAP clock. */
 	if (syscon_read_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, &val) == 0 && !(val & PCAP_CLKACT)) {
 		(void)syscon_write_reg(cfg->slcr, SLCR_PCAP_CLK_CTRL, val | PCAP_CLKACT);
 	}
 
+	pcap_rate = xadc_pcap_rate(dev);
+	tck_div = xadc_tck_divider(pcap_rate, &tckrate);
+	if (pcap_rate == 0U) {
+		LOG_WRN("PCAP clock rate unknown, using the slowest XADC TCK (PCAP/16)");
+	} else if (pcap_rate > XADC_PCAP_MAX_HZ) {
+		LOG_WRN("PCAP clock %u Hz exceeds %u Hz", pcap_rate, XADC_PCAP_MAX_HZ);
+	}
+	LOG_DBG("PCAP clock %u Hz, XADC TCK = PCAP / %u", pcap_rate, tck_div);
+
 	xadc_write32(dev, XADCIF_MCTL, MCTL_RESET);
 	xadc_write32(dev, XADCIF_MCTL, 0);
 	xadc_write32(dev, XADCIF_INTSTS, UINT32_MAX);
-	/* All interrupts masked, results are polled */
+	/* All interrupts masked until an alarm trigger is set */
 	xadc_write32(dev, XADCIF_INTMSK, UINT32_MAX);
-	/*
-	 * Slowest TCK divider (PCAP clock / 16, at most 12.5 MHz), well below the 50 MHz
-	 * limit and independent of the PCAP clock configuration chosen by U-Boot/Linux.
-	 */
 	xadc_write32(dev, XADCIF_CFG,
-		     CFG_ENABLE | CFG_REDGE | CFG_WEDGE | CFG_TCKRATE_DIV16 |
-			     CFG_IGAP(CFG_IGAP_DEFAULT));
+		     CFG_ENABLE | CFG_REDGE | CFG_WEDGE | tckrate | CFG_IGAP(CFG_IGAP_DEFAULT));
+
+	/* All alarms start disabled; zynq_xadc_trigger_set() enables them one by one */
+	err = xadc_update_reg(dev, XADC_REG_CONF1, CONF1_ALARM_DISABLE, CONF1_ALARM_DISABLE);
+	if (err == 0) {
+		err = xadc_set_samplerate(dev, pcap_rate ? pcap_rate / tck_div : 0U);
+	}
+	if (err == 0 && cfg->chan_mask != 0U) {
+		err = xadc_setup_sequencer(dev);
+	}
+
+	return err;
+}
+
+int zynq7000_xadc_reconfigure(const struct device *dev)
+{
+	struct zynq_xadc_data *data = dev->data;
+	k_spinlock_key_t key;
+	int err;
+
+	if (!device_is_ready(dev)) {
+		return -ENODEV;
+	}
+
+	/* Stop the deferred work first, nothing can re-arm an alarm that is being reset */
+	(void)k_work_cancel_delayable(&data->unmask_work);
+
+	key = k_spin_lock(&data->alarm_lock);
+	data->alarm_en = 0U;
+	data->alarm_masked = 0U;
+	(void)atomic_set(&data->alarm_pending, 0);
+	k_spin_unlock(&data->alarm_lock, key);
+
+	for (int i = 0; i < ALARM_COUNT; i++) {
+		data->handler[i] = NULL;
+	}
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	err = xadc_hw_setup(dev);
+	k_mutex_unlock(&data->lock);
+
+	return err;
+}
+
+static int zynq_xadc_init(const struct device *dev)
+{
+	const struct zynq_xadc_config *cfg = dev->config;
+	struct zynq_xadc_data *data = dev->data;
+	int err;
+
+	if (!device_is_ready(cfg->slcr)) {
+		LOG_ERR("SLCR device not ready");
+		return -ENODEV;
+	}
+
+	data->dev = dev;
+	k_mutex_init(&data->lock);
+	k_work_init(&data->alarm_work, xadc_alarm_work_handler);
+	k_work_init_delayable(&data->unmask_work, xadc_unmask_work_handler);
+
+	err = xadc_hw_setup(dev);
+	if (err) {
+		LOG_ERR("XADC setup failed: %d", err);
+		return err;
+	}
+
+	cfg->irq_config();
 
 	return 0;
 }
 
 static DEVICE_API(sensor, zynq_xadc_api) = {
+	.attr_set = zynq_xadc_attr_set,
+	.attr_get = zynq_xadc_attr_get,
+	.trigger_set = zynq_xadc_trigger_set,
 	.sample_fetch = zynq_xadc_sample_fetch,
 	.channel_get = zynq_xadc_channel_get,
 };
 
+#define XADC_CHAN_BIT(node_id, prop, idx) BIT(DT_PROP_BY_IDX(node_id, prop, idx))
+#define XADC_CHAN_MASK(prop)                                                                       \
+	COND_CODE_1(DT_INST_NODE_HAS_PROP(0, prop),                                                \
+		    ((DT_INST_FOREACH_PROP_ELEM_SEP(0, prop, XADC_CHAN_BIT, (|)))), (0))
+
+BUILD_ASSERT((XADC_CHAN_MASK(xlnx_channels) & ~XADC_AUX_MASK) == 0,
+	     "xlnx,channels entries must be 0-15 (VAUX) or 16 (VP/VN)");
+BUILD_ASSERT((XADC_CHAN_MASK(xlnx_bipolar_channels) & ~XADC_CHAN_MASK(xlnx_channels)) == 0,
+	     "xlnx,bipolar-channels must be a subset of xlnx,channels");
+
+static void zynq_xadc_irq_config(void)
+{
+	IRQ_CONNECT(DT_INST_IRQN(0), DT_INST_IRQ(0, priority), zynq_xadc_isr,
+		    DEVICE_DT_INST_GET(0), DT_INST_IRQ(0, flags));
+	irq_enable(DT_INST_IRQN(0));
+}
+
 static struct zynq_xadc_data zynq_xadc_data_0;
 
 static const struct zynq_xadc_config zynq_xadc_config_0 = {
 	.base = DT_INST_REG_ADDR(0),
 	.slcr = DEVICE_DT_GET(DT_INST_PHANDLE(0, syscon)),
+	.ps_clk_hz = DT_INST_PROP(0, ps_clk_frequency),
+	.chan_mask = XADC_CHAN_MASK(xlnx_channels),
+	.bipolar_mask = XADC_CHAN_MASK(xlnx_bipolar_channels),
+	.irq_config = zynq_xadc_irq_config,
 };
 
 SENSOR_DEVICE_DT_INST_DEFINE(0, zynq_xadc_init, NULL, &zynq_xadc_data_0, &zynq_xadc_config_0,
