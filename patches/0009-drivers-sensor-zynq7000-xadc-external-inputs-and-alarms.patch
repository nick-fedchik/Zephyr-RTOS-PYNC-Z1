+/* Write one XADC register; the caller holds the lock. */
+static int xadc_write_reg(const struct device *dev, uint8_t reg, uint16_t val)
+{
+	int err;
+
+	xadc_drain_fifo(dev);
+
+	xadc_write32(dev, XADCIF_CMDFIFO, XADC_CMD(CMD_WRITE, reg, val));
+
+	err = xadc_wait_dfifo(dev, 1U);
+	if (err) {
+		return err;
+	}
+
+	(void)xadc_read32(dev, XADCIF_RDFIFO);
+
+	return 0;
+}
