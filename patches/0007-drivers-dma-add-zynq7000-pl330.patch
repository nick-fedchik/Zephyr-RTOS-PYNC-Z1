@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Xilinx Zynq-7000 PS DMA controller (ARM PrimeCell PL330, DMAC)
+
+  The interrupts are, in order: the abort interrupt followed by one
+  interrupt per DMA channel (event 0..7). Channel n is addressed as
+  "dmas = <&dmac_s n>".
+
+compatible: "xlnx,zynq-dma-pl330"
+
+include: [dma-controller.yaml, base.yaml]
+
+properties:
+  reg:
+    required: true
+
+  interrupts:
+    required: true
+
+  dma-channels:
+    required: true
+
+  "#dma-cells":
+    const: 1
+
+dma-cells:
+  - channel
