diff --git a/dts/bindings/watchdog/cdns,wdt-r1p2.yaml b/dts/bindings/watchdog/cdns,wdt-r1p2.yaml
new file mode 100644
index 00000000000..d292973b0cf
--- /dev/null
+++ b/dts/bindings/watchdog/cdns,wdt-r1p2.yaml
@@ -0,0 +1,26 @@
+# Copyright (c) 2026 Zephyr-RTOS-PYNC-Z1 contributors
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Cadence system watchdog timer (SWDT) of the Xilinx Zynq-7000 processing
+  system (UG585 chapter 8). The compatible string matches the Linux
+  devicetree binding.
+
+compatible: "cdns,wdt-r1p2"
+
+include: base.yaml
+
+properties:
+  reg:
+    required: true
+
+  interrupts:
+    required: true
+
+  clock-frequency:
+    type: int
+    required: true
+    description: |
+      Frequency in Hz of the clock that drives the watchdog counter. After
+      reset the SWDT runs from CPU_1x (the CPU clock divided by 6 in the
+      6:2:1 configuration, 108333333 Hz for a 650 MHz CPU clock).
