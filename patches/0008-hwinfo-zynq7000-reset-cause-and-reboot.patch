index 00000000000..68983b93504
--- /dev/null
+++ b/soc/xlnx/zynq7000/common/reboot.c
@@ -0,0 +1,31 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * sys_reboot() for the Zynq-7000: SLCR PSS_RST_CTRL soft reset. The BootROM then
+ * runs again (SD/QSPI/JTAG per the boot mode pins), REBOOT_STATUS bit 19 is set.
+ */
+
+#include <zephyr/devicetree.h>
+#include <zephyr/irq.h>
+#include <zephyr/sys/reboot.h>
+#include <zephyr/sys/sys_io.h>
+
+#define SLCR_BASE         DT_REG_ADDR(DT_NODELABEL(slcr))
+#define SLCR_UNLOCK       (SLCR_BASE + 0x008)
+#define SLCR_PSS_RST_CTRL (SLCR_BASE + 0x200)
+
+#define SLCR_UNLOCK_KEY 0xdf0d
+#define PSS_RST_SOFT    BIT(0)
+
+void sys_arch_reboot(int type)
+{
+	ARG_UNUSED(type);
+
+	(void)irq_lock();
+
+	sys_write32(SLCR_UNLOCK_KEY, SLCR_UNLOCK);
+	sys_write32(PSS_RST_SOFT, SLCR_PSS_RST_CTRL);
+
+	for (;;) {
+	}
+}
